FROM clickhouse/minio-minio:RELEASE.2026-08-04T00-00-00Z AS minio

FROM ubuntu:latest

# Install required packages
RUN apt update
RUN apt install --yes iproute2 procps

# MinIO stopped publishing binaries on dl.min.io (HTTP 410).
# Copy the binary from the clickhouse/ mirror of the pgsty/minio community fork.
COPY --from=minio /usr/bin/minio /usr/local/bin/minio

# Create data directory
RUN mkdir -p /data

# Set Minio environment variables
ENV MINIO_ROOT_USER=minio
ENV MINIO_ROOT_PASSWORD=minio123
ENV MINIO_DOMAIN=minio

# Expose Minio ports
EXPOSE 9000 9001

# Set the entrypoint
ENTRYPOINT ["/usr/local/bin/minio"]
CMD ["server", "/data", "--console-address", ":9001"]
