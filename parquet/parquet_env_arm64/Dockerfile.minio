FROM quay.io/minio/minio:RELEASE.2022-07-17T15-43-14Z AS minio

FROM ubuntu:latest

# Install required packages
RUN apt update
RUN apt install --yes iproute2 procps

# MinIO stopped publishing binaries on dl.min.io (HTTP 410).
# Copy the binary from the public quay.io image instead.
# This 2022 tag keeps minio at /opt/bin/minio, not /usr/bin/minio.
COPY --from=minio /opt/bin/minio /usr/local/bin/minio

# Create data directory
RUN mkdir -p /data

# Set Minio environment variables
ENV MINIO_ROOT_USER=minio
ENV MINIO_ROOT_PASSWORD=minio123
ENV MINIO_DOMAIN=minio

# Expose Minio ports
EXPOSE 9000 9001

# Set the entrypoint
ENTRYPOINT ["/usr/local/bin/minio"]
CMD ["server", "/data", "--console-address", ":9001"]
